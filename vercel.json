{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/auth/google/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/auth/spotify/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/auth/plaid/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/data/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/user/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/apps/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|assets|favicon.ico|manifest.webmanifest|icon-192.png|sw.js).*|[^.]+)",
      "destination": "/index.html"
    }
  ]
}
